pipeline {                               // pre-build 
    agent {
        node{
            label 'AGENT'
        }
    }
    environment {
        COURSE = "jenkins"
    }
    stages {
        stage('Build') {                    // build 
            steps {
                script{
                    sh """
                        echo "Building"  
                        echo $COURSE
                        env  
                    """
                }
                
            }
        }
        stage('Test') {
            steps {
                script{
                    sh """
                        echo "Testing"
                    """
                }
                
            }
        }
        stage('Deploy') {
            steps {
                script{
                    sh """
                        echo "Deploying"
                    """
                }
            
